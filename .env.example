# Copie este arquivo para .env e troque os valores abaixo.
# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-esta-chave

# Login do professor. Gere o hash com:  python app.py --senha
# Sem ADMIN_PASSWORD_HASH o app roda sem login (e avisa no console).
ADMIN_USER=professor
ADMIN_PASSWORD_HASH=

# 127.0.0.1 = só este notebook acessa o app (recomendado; o telão abre aqui).
# Use 0.0.0.0 apenas se outro aparelho precisar abrir as telas.
APP_HOST=127.0.0.1

# Tamanho máximo do best.pt enviado, em MB.
MAX_UPLOAD_MB=100
